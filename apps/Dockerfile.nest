# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    npm_config_store_dir=/pnpm/store \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CYPRESS_INSTALL_BINARY=0 \
    CI=true
RUN corepack enable
WORKDIR /app

# --- Dépendances : seuls les manifests sont copiés.
# Le cache de ce layer ne saute que si un package.json ou le lockfile change.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/schema/package.json packages/schema/
COPY packages/tailwind-config/package.json packages/tailwind-config/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/jest-config/package.json packages/jest-config/
COPY packages/ui/package.json packages/ui/
ENV NODE_OPTIONS=--max-old-space-size=1024
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --network-concurrency=2 --child-concurrency=1

# --- Dev : sources montées en volume, lancement en watch
FROM deps AS dev
ENV NODE_ENV=development \
    NODE_OPTIONS=--max-old-space-size=384 \
    APP=gateway     
    
# `exec` : pnpm reçoit SIGTERM et l'arrêt est propre.
CMD ["sh", "-c", "exec pnpm exec rspack build --watch -c apps/api/rspack.config.mjs --env app=${APP}"]

# --- Build prod
FROM deps AS build
ARG APP
ENV NODE_ENV=production
COPY . .
RUN pnpm build ${APP}

# --- Runtime prod
FROM base AS prod
ARG APP
ENV NODE_ENV=production APP=${APP}
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod
COPY --from=build /app/dist/apps/${APP} ./dist
USER node
CMD ["node", "--max-old-space-size=384", "dist/main.cjs"]