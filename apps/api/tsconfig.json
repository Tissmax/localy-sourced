{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "baseUrl": "./",
    "outDir": "./dist",
    "strictNullChecks": true,
    "paths": {
      "@app/contracts": [
        "libs/contracts/src"
      ],
      "@app/contracts/*": [
        "libs/contracts/src/*"
      ],
      "@app/entities": [
        "libs/entities/src"
      ],
      "@app/entities/*": [
        "libs/entities/src/*"
      ],
      "@app/modules": [
        "libs/modules/src"
      ],
      "@app/modules/*": [
        "libs/modules/src/*"
      ]
    }
  }
}