{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "rspack dev -c rspack.config.mjs --env app=gateway",
    "build": "rspack build -c rspack.config.mjs",
    "start:prod": "node dist/apps/gateway/main.cjs",
    "start:debug": "nest start --debug --watch",
    "test": "vitest --passWithNoTests",
    "test:watch": "vitest --watch",
    "e2e:up": "docker compose --progress plain -p e2e -f docker-compose.e2e.yml --env-file ../../.env.test build gateway && docker compose --progress quiet -p e2e -f docker-compose.e2e.yml --env-file ../../.env.test up -d --wait --no-build",
    "e2e:down": "docker compose --progress quiet -p e2e -f docker-compose.e2e.yml --env-file ../../.env.test down -v",
    "e2e:logs": "docker compose -p e2e -f docker-compose.e2e.yml --env-file ../../.env.test logs --tail=100",
    "e2e:run": "vitest run --config ./vitest.e2e.config.ts",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "test:e2e:standalone": "pnpm -s e2e:up || { pnpm -s e2e:logs; pnpm -s e2e:down; exit 1; }; pnpm -s test:e2e; code=$?; pnpm -s e2e:down; exit $code",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "@repo/schema": "workspace:^",
    "argon2": "^0.45.1",
    "bull": "^4.16.5",
    "escape-html": "^1.0.3",
    "mysql2": "^3.24.5",
    "nats": "^2.29.3",
    "nestjs-zod": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^12.1.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.16.18",
    "@types/bull": "^4.10.4",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^9.39.2",
    "run-script-webpack-plugin": "^0.2.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.2",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "webpack": "^5.105.4",
    "zod": "^4.5.4"
  }
}