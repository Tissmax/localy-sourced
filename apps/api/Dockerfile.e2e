# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=24.13.1

FROM node:${NODE_VERSION}-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS prune
RUN --mount=type=cache,target=/root/.npm npm install -g turbo
COPY . .
RUN turbo prune api --docker

FROM base AS e2e
# 1. Dépendances : cette couche ne se reconstruit que si package.json / lockfile changent
COPY --from=prune /app/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --node-linker=hoisted
# 2. Sources + compilation unique des 4 apps
COPY --from=prune /app/out/full/ .
RUN for app in gateway products users sales; do \
      pnpm --filter api exec nest build $app || exit 1; \
    done
ENV NODE_ENV=test
USER node