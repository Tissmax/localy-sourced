{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"{src,app,libs,test}/**/{*.ts,*.tsx}\"",
    "check-types": "tsc --noEmit",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "start:e2e": "NEXT_TELEMETRY_DISABLED=1 PORT=3003 HOSTNAME=0.0.0.0 node .next/standalone/apps/web/server.js > .next-e2e.log 2>&1",
    "test:a11y": "start-server-and-test start:e2e http://localhost:${NEXT_PUBLIC_PORT} 'cypress run'",
    "test:e2e": "pnpm -s test:a11y"
  },
  "dependencies": {
    "@repo/schema": "workspace:^",
    "@tailwindcss/postcss": "^4.3.3",
    "axe-core": "^4.14.0",
    "cypress": "^16.2.0",
    "cypress-axe": "^1.7.0",
    "next": "16.4.1",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "eslint": "^9.31.0",
    "next-rspack": "^16.4.2",
    "start-server-and-test": "^3.0.13",
    "typescript": "5.8.2",
    "vitest": "^5.0.5"
  }
}
