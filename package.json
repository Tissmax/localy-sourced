{
  "name": "localy-sourced",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "docker compose down && docker compose build gateway && docker compose up -d",
    "dev:build": "docker compose down && docker compose up --build",
    "build": "turbo run build --filter=!web",
    "build --full": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "bash scripts/e2e.sh",
    "test:a11y": "turbo run test:a11y",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "logs": "docker compose logs -f --tail=100",
    "logs:api": "docker compose logs -f --tail=100 gateway users sales products",
    "logs:web": "docker compose logs -f --tail=100 web",
    "logs:infra": "docker compose logs -f --tail=50 nats redis postgres",
    "logs:err": "docker compose logs -f --tail=300 | grep -i --line-buffered -E 'error|exception|fatal|ECONN|killed'"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "napi-postinstall": "0.3.4",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@<6.14.0": "^6.14.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "flatted@<3.4.2": "^3.4.2",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "next@>=16.0.0 <16.3.8": "^16.3.8",
      "picomatch@<2.3.2": "^2.3.2",
      "proxy-addr@>=1.1.0 <2.0.8": "^2.0.8",
      "qs@>=2.2.5 <6.16.0": "^6.16.0",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "uuid@<11.1.1": "^11.1.1",
      "zod@<4.6.6": ">=4.6.6",
      "body-parser@>=2.0.0 <2.4.0": ">=2.4.0",
      "multer@>=2.0.0 <2.5.0": ">=2.5.0"
    }
  }
}