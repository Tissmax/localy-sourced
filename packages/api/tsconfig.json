{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": false,
    "types": ["node"],
    "strictNullChecks": true,
    "rootDir": "./src",
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*.spec.ts"]
}