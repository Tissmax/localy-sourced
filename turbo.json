{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {},
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["E2E_*", "NEXT_PUBLIC_*"]
    },
    "web#test:e2e": {
      "cache": false,
      "dependsOn": ["^build", "build", "api#test:e2e"],
      "passThroughEnv": ["E2E_*", "NEXT_PUBLIC_*"]
    }                            
  }
}
